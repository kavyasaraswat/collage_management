datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password      String
  role          String      @default("STUDENT") // ADMIN, TEACHER, STUDENT
  isDeactivated Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  student       Student?
  teacher       Teacher?
  auditLogs     AuditLog[]
  notifications Notification[]
  markedAttendance Attendance[] @relation("MarkedBy")
  enteredMarks   Marks[]     @relation("EnteredBy")
  noticesCreated Notice[]    @relation("NoticeAuthor")
  documentsUploaded Document[] @relation("DocumentUploader")
}

model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  courses     Course[]
  teachers    Teacher[]
  students    Student[]
  notices     Notice[]
}

model Course {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  departmentId   String
  totalSemesters Int       @default(8)
  durationYears  Int       @default(4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  semesters      Semester[]
  sections       Section[]
  students       Student[]
  enrollments    Enrollment[]
  feeStructures  FeeStructure[]
  timetables     Timetable[]
  notices        Notice[]
}

model Subject {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  courseId       String
  semesterNumber Int
  credits        Int       @default(4)
  isPractical    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  attendances    Attendance[]
  exams          Exam[]
  marks          Marks[]
  timetables     Timetable[]
}

model Semester {
  id           String   @id @default(uuid())
  number       Int
  academicYear String
  isCurrent    Boolean  @default(false)
  courseId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections      Section[]
  students      Student[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  timetables    Timetable[]
  notices       Notice[]

  @@unique([courseId, number, academicYear])
}

model Section {
  id          String   @id @default(uuid())
  name        String
  courseId    String
  semesterId  String
  capacity    Int      @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester        Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students        Student[]
  enrollments     Enrollment[]
  teacherSubjects TeacherSubject[]
  attendances     Attendance[]
  timetables      Timetable[]
  notices         Notice[]

  @@unique([courseId, semesterId, name])
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  studentId     String    @unique
  name          String
  email         String    @unique
  phone         String?
  dob           String?
  gender        String?
  address       String?
  departmentId  String
  courseId      String
  semesterId    String
  sectionId     String
  batch         String
  admissionDate String?
  profilePhoto  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department @relation(fields: [departmentId], references: [id])
  course        Course     @relation(fields: [courseId], references: [id])
  semester      Semester   @relation(fields: [semesterId], references: [id])
  section       Section    @relation(fields: [sectionId], references: [id])

  enrollments   Enrollment[]
  attendances   Attendance[]
  marks         Marks[]
  studentFees   StudentFee[]
  payments      FeePayment[]
  documents     Document[]
}

model Teacher {
  id           String   @id @default(uuid())
  userId       String   @unique
  teacherId    String   @unique
  name         String
  email        String   @unique
  phone        String?
  departmentId String
  designation  String
  joiningDate  String?
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id])
  teacherSubjects TeacherSubject[]
  timetables      Timetable[]
}

model Enrollment {
  id           String   @id @default(uuid())
  studentId    String
  courseId     String
  semesterId   String
  sectionId    String
  academicYear String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  section  Section  @relation(fields: [sectionId], references: [id])

  @@unique([studentId, semesterId, academicYear])
}

model TeacherSubject {
  id           String   @id @default(uuid())
  teacherId    String
  subjectId    String
  sectionId    String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, sectionId, academicYear])
}

model Attendance {
  id         String   @id @default(uuid())
  studentId  String
  subjectId  String
  sectionId  String
  date       String
  status     String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  markedById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User    @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, subjectId, date])
}

model Exam {
  id           String   @id @default(uuid())
  name         String
  examType     String   @default("INTERNAL_1") // INTERNAL_1, INTERNAL_2, MID_SEM, END_SEM, PRACTICAL, ASSIGNMENT, QUIZ
  subjectId    String
  maxMarks     Float    @default(100)
  date         String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Marks[]
}

model Marks {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  subjectId     String
  marksObtained Float
  enteredById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enteredBy User    @relation("EnteredBy", fields: [enteredById], references: [id])

  @@unique([examId, studentId])
}

model FeeStructure {
  id           String   @id @default(uuid())
  title        String
  courseId     String
  semesterId   String
  tuitionFee   Float    @default(0)
  hostelFee    Float    @default(0)
  examFee      Float    @default(0)
  libraryFee   Float    @default(0)
  otherFees    Float    @default(0)
  totalAmount  Float
  academicYear String
  dueDate      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentFees StudentFee[]
}

model StudentFee {
  id              String   @id @default(uuid())
  studentId       String
  feeStructureId  String
  totalAmount     Float
  paidAmount      Float    @default(0)
  remainingAmount Float
  status          String   @default("PENDING") // PAID, PARTIALLY_PAID, PENDING, OVERDUE
  dueDate         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
}

model FeePayment {
  id              String   @id @default(uuid())
  studentFeeId    String
  studentId       String
  transactionId   String   @unique
  amount          Float
  paymentMethod   String   @default("ONLINE")
  paymentStatus   String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  isMock          Boolean  @default(true)
  gatewayResponse String?
  createdAt       DateTime @default(now())

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Timetable {
  id         String   @id @default(uuid())
  dayOfWeek  String
  startTime  String
  endTime    String
  subjectId  String
  teacherId  String
  roomId     String
  courseId   String
  semesterId String
  sectionId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Notice {
  id             String   @id @default(uuid())
  title          String
  content        String
  attachmentUrl  String?
  targetAudience String   @default("EVERYONE") // EVERYONE, DEPARTMENT, COURSE, SEMESTER, SECTION
  departmentId   String?
  courseId       String?
  semesterId     String?
  sectionId      String?
  authorId       String
  publishDate    String
  expiryDate     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  course     Course?     @relation(fields: [courseId], references: [id])
  semester   Semester?   @relation(fields: [semesterId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])
  author     User        @relation("NoticeAuthor", fields: [authorId], references: [id])
}

model Document {
  id           String   @id @default(uuid())
  studentId    String
  title        String
  docType      String
  fileUrl      String
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

